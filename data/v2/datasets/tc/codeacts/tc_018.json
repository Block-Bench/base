{"by_variant":{"minimalsanitized":[{"id":"CA1","type":"DECLARATION","lines":[29,30,31,32,33,34],"code":"function init(\n    address _maintainer,\n    address _baseToken,\n    address _quoteToken,\n    uint256 _lpFeeRate\n) external {\n","security_function":"ROOT_CAUSE","rationale":"ROOT_CAUSE - init function has no require(!isInitialized) guard. Anyone can call init() multiple times to reinitialize the pool and become the new maintainer."},{"id":"CA2","type":"STATE_MOD","lines":[37,38,39,40],"code":"maintainer = _maintainer;\nbaseToken = _baseToken;\nquoteToken = _quoteToken;\nlpFeeRate = _lpFeeRate;\n","security_function":"BENIGN","rationale":"State overwrites during init. These are consequences of calling unguarded init() - the root cause is the missing guard (CA1)."},{"id":"CA3","type":"DECLARATION","lines":[25],"code":"bool public isInitialized;","security_function":"BENIGN","rationale":"isInitialized flag declaration. Represents a failed mitigation attempt - the flag exists but is not checked in init()."},{"id":"CA4","type":"STATE_MOD","lines":[43],"code":"isInitialized = true;","security_function":"BENIGN","rationale":"Sets isInitialized but doesn't prevent reinitialization since init() doesn't check this flag. Ineffective safeguard."},{"id":"CA5","type":"INPUT_VAL","lines":[52],"code":"require(isInitialized, \"Not initialized\");","security_function":"BENIGN","rationale":"Correct initialization check in addLiquidity. Shows isInitialized is used elsewhere but not in init()."},{"id":"CA6","type":"INPUT_VAL","lines":[69],"code":"require(isInitialized, \"Not initialized\");","security_function":"BENIGN","rationale":"Correct initialization check in swap. Shows intended pattern."},{"id":"CA7","type":"EXT_CALL","lines":[54,55],"code":"IERC20(baseToken).transferFrom(msg.sender, address(this), baseAmount);\nIERC20(quoteToken).transferFrom(msg.sender, address(this), quoteAmount);\n","security_function":"BENIGN","rationale":"Token transfers in addLiquidity. Correctly implemented."},{"id":"CA8","type":"STATE_MOD","lines":[57,58],"code":"baseBalance += baseAmount;\nquoteBalance += quoteAmount;\n","security_function":"BENIGN","rationale":"Balance updates in addLiquidity."},{"id":"CA9","type":"INPUT_VAL","lines":[70,71,72,73,74],"code":"require(\n    (fromToken == baseToken && toToken == quoteToken) ||\n        (fromToken == quoteToken && toToken == baseToken),\n    \"Invalid token pair\"\n);\n","security_function":"BENIGN","rationale":"Token pair validation in swap. Correctly implemented."},{"id":"CA10","type":"COMPUTATION","lines":[80,81,82,83,84,85,86,87,88],"code":"if (fromToken == baseToken) {\n    toAmount = (quoteBalance * fromAmount) / (baseBalance + fromAmount);\n    baseBalance += fromAmount;\n    quoteBalance -= toAmount;\n} else {\n    toAmount = (baseBalance * fromAmount) / (quoteBalance + fromAmount);\n    quoteBalance += fromAmount;\n    baseBalance -= toAmount;\n}\n","security_function":"BENIGN","rationale":"Swap amount calculation using constant product formula."},{"id":"CA11","type":"COMPUTATION","lines":[91,92],"code":"uint256 fee = (toAmount * lpFeeRate) / 10000;\ntoAmount -= fee;\n","security_function":"BENIGN","rationale":"Fee calculation. This is impact amplification - any value-bearing role is exploitable once maintainer is hijacked."},{"id":"CA12","type":"EXT_CALL","lines":[95,98],"code":"IERC20(toToken).transfer(msg.sender, toAmount);\nIERC20(toToken).transfer(maintainer, fee);\n","security_function":"BENIGN","rationale":"Token transfers including fee to maintainer. Post-exploit consequence - defines where value flows after compromise."},{"id":"CA13","type":"ACCESS_CTRL","lines":[107],"code":"require(msg.sender == maintainer, \"Only maintainer\");","security_function":"BENIGN","rationale":"Maintainer check in claimFees. Correct access control - bypassed after reinitialization as a consequence."},{"id":"CA14","type":"CTRL_FLOW","lines":[115,116,117,118,120,121,122,123],"code":"if (baseTokenBalance > baseBalance) {\n    uint256 excess = baseTokenBalance - baseBalance;\n    IERC20(baseToken).transfer(maintainer, excess);\n}\nif (quoteTokenBalance > quoteBalance) {\n    uint256 excess = quoteTokenBalance - quoteBalance;\n    IERC20(quoteToken).transfer(maintainer, excess);\n}\n","security_function":"BENIGN","rationale":"Fee claim logic. Post-exploit consequence - the exploit is complete at maintainer overwrite."},{"id":"CA15","type":"EVENT_EMIT","lines":[45],"code":"emit Initialized(_maintainer, _baseToken, _quoteToken);","security_function":"BENIGN","rationale":"Event emission in init. No security impact."},{"id":"CA16","type":"CTRL_FLOW","lines":[100],"code":"return toAmount;","security_function":"BENIGN","rationale":"Return statement."},{"id":"CA_DIRECTIVES","type":"DIRECTIVE","lines":[1,2],"security_function":"UNRELATED","rationale":"License and pragma statements"},{"id":"CA_COMMENTS","type":"COMMENT","lines":[48,49,50,61,62,63,76,79,90,94,97,103,104,105,109,110,114],"security_function":"UNRELATED","rationale":"Inline comments and NatSpec documentation"},{"id":"CA_DECLARATIONS","type":"DECLARATION","lines":[4,5,7,9,10,11,12,13,14,16,17,18,19,21,22,23,27,51,64,65,66,67,68,77,106,111,112],"security_function":"UNRELATED","rationale":"Interface, contract, event, and function signature declarations"},{"id":"CA_SYNTAX","type":"SYNTAX","lines":[46,59,101,124,125],"security_function":"UNRELATED","rationale":"Closing braces"}],"differential":[{"id":"CA_FIX1","type":"INPUT_VAL","lines":[35],"code":"require(!isInitialized, \"Already initialized\");","security_function":"BENIGN","rationale":"FIX - Prevents reinitialization attack by checking isInitialized flag before allowing init()"},{"id":"CA1","type":"DECLARATION","lines":[17,18,19],"code":"address public maintainer;\naddress public baseToken;\naddress public quoteToken;\n","security_function":"BENIGN","rationale":"Pool configuration state variables"},{"id":"CA2","type":"DECLARATION","lines":[21,22,23],"code":"uint256 public lpF